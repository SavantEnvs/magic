VERSION 5.7 ;
   NAMESCASESENSITIVE ON ;
   DIVIDERCHAR "/" ;
   BUSBITCHARS "()" ;
   DESIGN tut7b ;
   TECHNOLOGY scmos ;
   UNITS DISTANCE MICRONS 1000 ;
   DIEAREA ( -66000 -181000 ) ( 100000 102000 ) ;

VIAS 0 ;
END VIAS

COMPONENTS 2 ;
   - tut7c_1 tut7c
      + PLACED ( 18000 -106000 ) N ;
   - tut7c_0 tut7c
      + PLACED ( 11000 26000 ) N ;
END COMPONENTS

PINS 0 ;
END PINS

